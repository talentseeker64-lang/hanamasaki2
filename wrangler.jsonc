{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker kustom: memakai ulang handler fetch hasil build OpenNext, lalu
  // menambahkan handler scheduled untuk Cron Trigger sinkronisasi metrik.
  "main": "worker.ts",
  "name": "hanamasaki2",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    // Mengaktifkan API Node.js di runtime Workers.
    "nodejs_compat",
    // Mengizinkan aplikasi melakukan fetch ke URL publik.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // Nama binding yang dipakai aplikasi lewat getCloudflareContext().env.DB.
      "binding": "DB",
      // Nama database seperti yang terdaftar di dashboard Cloudflare.
      // Nilai ini juga dipakai sebagai argumen perintah `wrangler d1`.
      "database_name": "karambit",
      "database_id": "865475e1-00a0-4abc-baef-6feaec3da107"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Wajib sama persis dengan nilai "name" di atas. Kalau berbeda,
      // deploy gagal dengan error 10143 (service binding not found).
      "service": "hanamasaki2"
    }
  ],
  "triggers": {
    // Sinkronisasi metrik platform setiap 6 jam (00:00, 06:00, 12:00, 18:00 UTC).
    // Zona waktu Cloudflare Cron selalu UTC.
    "crons": ["0 */6 * * *"]
  }
}
